# Copy to .env.local and fill in. All NEXT_PUBLIC_* values have safe production defaults
# in lib/config.ts, so the site builds and runs even if these are unset.

# Canonical site origin (no trailing slash). Used for sitemap, robots, canonicals, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://owrites.co

# Calendly booking link. The contact form and every "Réserver un appel / une démo"
# CTA send the visitor here (the form pre-fills name + email into Calendly).
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/olaniyanolaide/discovery-call
